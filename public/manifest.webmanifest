{
  "name": "Logos — Text to Speech",
  "short_name": "Logos",
  "description": "Fast, private text-to-speech on your device. Listen instantly or render audio files in English and Spanish.",
  "id": "./",
  "scope": "./",
  "start_url": "./#/listen",
  "display": "standalone",
  "orientation": "any",
  "theme_color": "#0a0a0f",
  "background_color": "#0a0a0f",
  "categories": ["productivity", "education", "utilities"],
  "share_target": {
    "action": "./",
    "method": "GET",
    "params": { "title": "title", "text": "text", "url": "url" }
  },
  "shortcuts": [
    { "name": "Listen", "url": "./#/listen", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Create audio", "url": "./#/create", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] },
    { "name": "Library", "url": "./#/library", "icons": [{ "src": "icon-192.png", "sizes": "192x192" }] }
  ],
  "icons": [
    { "src": "icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ]
}
